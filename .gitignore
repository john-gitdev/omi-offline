# iOS — support was removed (see NOTES.md), but Flutter still leaves a
# generated scaffold in app/ios/. These rules keep it out of git; the
# Config/ rules also stop a GoogleService-Info.plist landing there.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/**/GeneratedPluginRegistrant.*
**/ios/Config/*
**/ios/Config/**/*
**/ios/Runner/GoogleService-Info.plist

# Archives and raw audio
*.zip
*.wav

