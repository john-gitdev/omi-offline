# iOS — support was removed (see NOTES.md), but Flutter still leaves a
# generated scaffold in app/ios/. These rules keep it out of git; the
# Config/ rules also stop a GoogleService-Info.plist landing there.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/**/GeneratedPluginRegistrant.*
**/ios/Config/*
**/ios/Config/**/*
**/ios/Runner/GoogleService-Info.plist

# Archives and raw audio
*.zip
*.wav

# ...except the consumer hardware manufacturing package. The Gerbers, Altium
# sources and CNC finish spec ship as .zip and are design SOURCE, not build
# output — the blanket *.zip above silently dropped all eight on import, leaving
# electrical/ with schematic PDFs and nothing orderable. They verify against
# omi/hardware/consumer/checksums.sha256.
!omi/hardware/consumer/**/*.zip

# Local-only — not tracked
/version.txt
/REFACTORING_INSTRUCTIONS.md
/diff.patch
/test_codec.dart
LOCAL_DEV_SETUP.md
.claude/settings.json
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
app/.claude/
app/.metadata
.backups/

# Generated browser snapshots (contain PII)
builds-snapshot.md
*-snapshot.md

# Built artifacts. The APKs are 300 MB+ — far past GitHub's 100 MB file limit —
# so they ship as release assets, never as tracked files.
/releases/*

# ...except the current firmware DFU bundle (~430 KB). It is the one artifact that
# cannot be rebuilt reliably: ccbuild.sh resolves "the newest NCS" rather than a
# pinned version, and says so itself (ccbuild.sh:122 — "An NCS or toolchain update
# changes the firmware"). Built with NCS v2.9.0. Keep exactly one bundle tracked:
# bump this line on each firmware release and git rm the one it replaces.
!/releases/oo314.zip

# Exported Omi bin archives and shared debug logs — real recorded audio and
# device logs pulled off a phone for analysis. Never commit these.
omi_bins_*/
logs/
